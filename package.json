{
  "name": "shadcn-design",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "shadcn-vue build -o .registry && nuxt build",
    "dev": "shadcn-vue build -o .registry && nuxt dev --host 0.0.0.0 --port 3015",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host 0.0.0.0 --port 3015",
    "start": "HOST=0.0.0.0 PORT=3015 node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "registry:build": "shadcn-vue build -o .registry",
    "registry:check": "shadcn-vue view ./.registry/interactive-hover-button.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@nuxt/content": "^3.16.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "3.21.11",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
